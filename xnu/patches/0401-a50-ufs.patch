@@ -776,7 +776,32 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 	 * Galaxy A50 (Exynos 9610): every driver below is Exynos 7580 or 8890
 	 * hardware at fixed physical addresses that belong to other blocks on
 	 * the 9610. None of them may run here; A50 drivers come later.
+	 *
+	 * The exception is bsd/dev/herolte_ufs.c, which reads its registers
+	 * from the device tree (/a50-ufs, Exynos 9610 layout): ufsprobe=1 only
+	 * reads (host state, LUN 0 GPT); rd=ufsroot0 serves the GPT partition
+	 * ufsroot= (default "userdata"), read only unless ufsrw=1.
 	 */
+	{
+	uint32_t ufsprobe = 0;
+	PE_parse_boot_argn("ufsprobe", &ufsprobe, sizeof(ufsprobe));
+	if (ufsprobe == 1) {
+		extern void herolte_ufs_probe(void);
+		herolte_ufs_probe();
+	}
+	}
+	if (strcmp(rdBootVar, "ufsroot0") == 0) {
+		extern int herolte_ufs_rootdev(dev_t *dev);
+		OSSafeReleaseNULL(matching);
+		int ufs_error = herolte_ufs_rootdev(root);
+		if (ufs_error) {
+			panic("IOFindBSDRoot: A50 UFS root %s unavailable: %d", rdBootVar, ufs_error);
+		}
+		strlcpy(rootName, rdBootVar, rootNameSize);
