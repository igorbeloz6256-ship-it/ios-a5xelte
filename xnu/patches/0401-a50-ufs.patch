+#if defined(ARM64_BOARD_CONFIG_A50)
+static bool
+all_bytes(const uint8_t *p, uint8_t v, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		if (p[i] != v) {
+			return false;
+		}
+	}
+	return true;
+}
+#endif
+
+/*
+ * How many bytes per PRDT entry the host walks (16, or 128 with Samsung FMP
+ * descriptors), measured with one READ(10) of LBA 1-2 (GPT header and the
+ * first entries) through the dual-placement PRDT in ufs_scsi. Read only.
+ * Must run before any multi-block transfer. HEROLTE keeps 16.
+ */
+static int
+ufs_detect_prdt_stride(void)
+{
+#if defined(ARM64_BOARD_CONFIG_A50)
+	uint8_t *b = (uint8_t *)(su.dma + DMA_BOUNCE);
+	static const uint8_t cdb[10] = { 0x28, 0, 0, 0, 0, 1, 0, 0, 2, 0 };
+
+	memset(b, 0x5a, 4 * UFS_BLOCK);
+	dma_sync(DMA_BOUNCE, 4 * UFS_BLOCK);
+	su.prdt_probe = true;
+	int error = ufs_scsi(cdb, sizeof(cdb), 2 * UFS_BLOCK, false);
+	su.prdt_probe = false;
+	dma_sync(DMA_BOUNCE, 4 * UFS_BLOCK);
+	if (error) {
+		printf("HEROLTE UFS: PRDT stride probe: READ(10) failed %d\n", error);
+		return error;
+	}
+	bool gpt = memcmp(b, "EFI PART", 8) == 0;
+	bool at16 = !all_bytes(b + UFS_BLOCK, 0x5a, UFS_BLOCK);
+	bool at128 = !all_bytes(b + 2 * UFS_BLOCK, 0x5a, UFS_BLOCK);
+	bool spare = !all_bytes(b + 3 * UFS_BLOCK, 0x5a, UFS_BLOCK);
+	printf("HEROLTE UFS: PRDT stride probe: LBA1 %.8s, 16-byte slot %s, 128-byte slot %s, spare %s\n",
+	    gpt ? (const char *)b : "not GPT", at16 ? "filled" : "empty",
+	    at128 ? "filled" : "empty", spare ? "filled" : "empty");
+	if (!gpt) {
+		return ENXIO;
+	}
+	if (at16 && !at128 && !spare) {
+		su.prdt_stride = 16;
+	} else if (at128 && !at16 && !spare) {
+		su.prdt_stride = 128;
+	} else {
+		return EIO;
+	}
+	printf("HEROLTE UFS: host walks %u-byte PRDT entries\n", su.prdt_stride);
+#else
+	su.prdt_stride = 16;
+#endif
+	return 0;
+}
