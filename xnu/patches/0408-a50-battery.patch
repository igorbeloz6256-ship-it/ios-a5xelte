diff --git a/bsd/dev/a50_battery.c b/bsd/dev/a50_battery.c
new file mode 100644
index 0000000..a88a615
--- /dev/null
+++ b/bsd/dev/a50_battery.c
@@ -0,0 +1,342 @@
+/*
+ * Galaxy A50 (SM-A505FN, Exynos 9610) battery: the SM5713's fuel gauge and
+ * charger status, read-only, for SweetBattery (iokit/Kernel/arm/SweetBattery.cpp),
+ * which polls every 30 s. In place of the S7's MAX77854 (herolte_battery.c).
+ *
+ * From the A50 kernel (universal9610, drivers/battery_v2/sm5713_fuelgauge.c,
+ * sm5713_charger.c, include/linux/mfd/sm5713-private.h) and its DTS:
+ *  - sm5713@49 on i2c_1 (S3C2440-style I2C at 0x13840000), pins gpp0-2 SDA,
+ *    gpp0-3 SCL, function 2, no pull (TOP pinctrl 0x139B0000, gpp0 at 0x000);
+ *  - fuel gauge at 0xE2 >> 1 = 0x71, 16-bit registers read as SMBus words
+ *    (low byte first): SOC 0x05 = integer % in bits 14:8, 1/256 % in 7:0
+ *    (bit 15: 0 %); VBAT 0x07: (v & 0x3fff) * 1000 >> 11 mV; CURRENT 0x08: same
+ *    scale in mA, bit 15 = negative (discharging);
+ *  - charger at 0x92 >> 1 = 0x49, byte registers: STATUS1 0x0D bit 0 VBUS_POK,
+ *    STATUS2 0x0E bit 3 charging on, bit 5 top-off (full).
+ * TWRP on this phone (2026-11-15, on USB, Android: 100 %, 4309 mV, Full):
+ * pinmux gpp0-2/3 = i2c1-bus; i2cget 1 0x71: 0x00 -> 0x01, 0x07 -> 0x78 (low
+ * byte of 4309 mV * 2048 / 1000 = 0x2278); 0x49: STATUS1 0x01, STATUS2 0x20.
+ *
+ * Writes: only the gpp0-2/3 fields (read-modify-write) and the I2C-1
+ * controller; the SM5713 only gets register addresses. Boot-arg a50fg=0
+ * keeps SweetBattery's static 100 %.
+ */
+#if defined(ARM64_BOARD_CONFIG_A50)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int herolte_fg_init(void);
+int herolte_fg_read(unsigned *percent, unsigned *mv, int *ma, unsigned *rem_mah, unsigned *full_mah);
+int a50_charger_read(int *vbus, int *charging, int *full);
+
+#define A50_TOP_PINCTRL_PA      0x139b0000u
+#define A50_GPP0                0x000u          /* i2c1: SDA pin 2, SCL pin 3 */
+#define PIN_CON                 0x00u
+#define PIN_PUD                 0x08u
+
+#define A50_I2C1_PA             0x13840000u
+#define IICCON                  0x00u
+#define IICSTAT                 0x04u
+#define IICDS                   0x0cu
+#define IICLC                   0x10u
+
+#define FG_ADDR                 0x71u
+#define FG_DEVICE_ID            0x00u
+#define FG_SOC                  0x05u
+#define FG_VBAT                 0x07u
+#define FG_CURRENT              0x08u
+#define CHG_ADDR                0x49u
+#define CHG_STATUS1             0x0du
+#define CHG_STATUS2             0x0eu
+#define A50_BATTERY_MAH         4000u           /* EB-BA505ABU; TWRP: CHARGE_FULL 4000000 uAh */
+
+static vm_offset_t ab_top, ab_i2c;
+static unsigned ab_errors;
+static int ab_restart = -1;     /* -1 not known yet, 1 repeated START works, 0 STOP between */
+
+static uint32_t
+ab_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+ab_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+static void
+ab_set_field(vm_offset_t base, uint32_t reg, unsigned pin, uint32_t value)
+{
+	uint32_t v = ab_rd(base, reg);
+	v = (v & ~(0xfu << (4 * pin))) | ((value & 0xfu) << (4 * pin));
+	ab_wr(base, reg, v);
+}
+
+static void
+ab_fail(const char *what, unsigned n)
+{
+	if (ab_errors++ < 12) {
+		printf("A50 BATTERY: I2C1 %s (%u) stat=%#x con=%#x\n", what, n, ab_rd(ab_i2c, IICSTAT),
+		    ab_rd(ab_i2c, IICCON));
+	}
+}
+
+static bool
+ab_wait_irq(void)
+{
+	for (unsigned n = 0; n < 20000; n++) {
+		if (ab_rd(ab_i2c, IICCON) & 0x10u) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+ab_clear_irq(void)
+{
+	ab_wr(ab_i2c, IICCON, ab_rd(ab_i2c, IICCON) & ~0x10u);
+}
+
+static void
+ab_stop(void)
+{
+	ab_wr(ab_i2c, IICSTAT, ab_rd(ab_i2c, IICSTAT) & ~0x20u);
+	ab_clear_irq();
+	for (unsigned n = 0; n < 5000; n++) {
+		if (!(ab_rd(ab_i2c, IICSTAT) & 0x20u)) {
+			break;
+		}
+		delay(1);
+	}
+}
+
+static bool
+ab_idle(void)
+{
+	for (unsigned n = 0; n < 5000; n++) {
+		if (!(ab_rd(ab_i2c, IICSTAT) & 0x20u)) {
+			return true;
+		}
+		delay(1);
+	}
+	ab_fail("busy", 0);
+	return false;
+}
+
+/* START (or repeated START when the bus is held) and the address byte; true when it was ACKed. */
+static bool
+ab_address(uint8_t chip, bool receive, bool restart)
+{
+	const uint32_t mode = receive ? 0x90u : 0xd0u;
+	if (!restart) {
+		ab_wr(ab_i2c, IICCON, 0xe3u);           /* ACK, IRQ enable, PCLK/512/4 */
+		ab_wr(ab_i2c, IICLC, 7u);               /* SDA delay and filter */
+	}
+	ab_wr(ab_i2c, IICSTAT, mode);
+	ab_wr(ab_i2c, IICDS, ((uint32_t)chip << 1) | (receive ? 1u : 0u));
+	delay(1);
+	if (restart) {
+		/* As Linux i2c-s3c2410 between messages: ACK on, START, then the pending interrupt released. */
+		ab_wr(ab_i2c, IICCON, ab_rd(ab_i2c, IICCON) | 0x80u);
+		ab_wr(ab_i2c, IICSTAT, mode | 0x20u);
+		ab_clear_irq();
+	} else {
+		ab_wr(ab_i2c, IICSTAT, mode | 0x20u);
+	}
+	if (!ab_wait_irq()) {
+		ab_fail("address timeout", chip);
+		return false;
+	}
+	if (ab_rd(ab_i2c, IICSTAT) & 1u) {
+		ab_fail("address NACK", chip);
+		return false;
+	}
+	return true;
+}
+
+static bool
+ab_receive(uint8_t *bytes, unsigned count)
+{
+	for (unsigned n = 0; n < count; n++) {
+		if (n + 1 == count) {
+			ab_wr(ab_i2c, IICCON, ab_rd(ab_i2c, IICCON) & ~0x80u);  /* NACK the last byte */
+		}
+		ab_clear_irq();
+		if (!ab_wait_irq()) {
+			ab_fail("data timeout", n);
+			return false;
+		}
+		bytes[n] = (uint8_t)ab_rd(ab_i2c, IICDS);
+	}
+	return true;
+}
+
+/* Register read: the address byte, then (repeated) START and count bytes. */
+static bool
+ab_read(uint8_t chip, uint8_t reg, uint8_t *bytes, unsigned count, bool restart)
+{
+	bool ok = false;
+	if (!ab_idle() || !ab_address(chip, false, false)) {
+		goto out;
+	}
+	ab_wr(ab_i2c, IICDS, reg);
+	delay(1);
+	ab_clear_irq();
+	if (!ab_wait_irq()) {
+		ab_fail("register timeout", reg);
+		goto out;
+	}
+	if (ab_rd(ab_i2c, IICSTAT) & 1u) {
+		ab_fail("register NACK", reg);
+		goto out;
+	}
+	if (!restart) {
+		ab_stop();
+		if (!ab_idle() || !ab_address(chip, true, false)) {
+			goto out;
+		}
+	} else if (!ab_address(chip, true, true)) {
+		goto out;
+	}
+	ok = ab_receive(bytes, count);
+out:
+	ab_stop();
+	return ok;
+}
+
+/* SMBus-style read: repeated START, as Linux does; STOP between if the first one ever fails. */
+static bool
+ab_reg(uint8_t chip, uint8_t reg, uint8_t *bytes, unsigned count)
+{
+	if (ab_restart != 0 && ab_read(chip, reg, bytes, count, true)) {
+		if (ab_restart < 0) {
+			ab_restart = 1;
+			printf("A50 BATTERY: I2C1 reads with a repeated START\n");
+		}
+		return true;
+	}
+	if (ab_restart <= 0 && ab_read(chip, reg, bytes, count, false)) {
+		if (ab_restart < 0) {
+			ab_restart = 0;
+			printf("A50 BATTERY: I2C1 reads with a STOP between address and data\n");
+		}
+		return true;
+	}
+	return false;
+}
+
+static bool
+ab_word(uint8_t reg, uint16_t *value)
+{
+	uint8_t b[2];
+	if (!ab_reg(FG_ADDR, reg, b, 2)) {
+		return false;
+	}
+	*value = (uint16_t)(b[0] | (b[1] << 8));
+	return true;
+}
+
+static unsigned
+ab_soc_tenths(uint16_t raw)
+{
+	if (raw & 0x8000u) {
+		return 0;
+	}
+	unsigned soc = ((raw & 0x7f00u) >> 8) * 10 + ((raw & 0x00ffu) * 10) / 256;
+	return soc > 1000 ? 1000 : soc;
+}
+
+static unsigned
+ab_mv(uint16_t raw)
+{
+	return ((raw & 0x3fffu) * 1000u) >> 11;
+}
+
+static int
+ab_ma(uint16_t raw)
+{
+	int ma = (int)(((raw & 0x3fffu) * 1000u) >> 11);
+	return (raw & 0x8000u) ? -ma : ma;
+}
+
+int
+a50_charger_read(int *vbus, int *charging, int *full)
+{
+	uint8_t s1 = 0, s2 = 0;
+	if (ab_i2c == 0 || !ab_reg(CHG_ADDR, CHG_STATUS1, &s1, 1) || !ab_reg(CHG_ADDR, CHG_STATUS2, &s2, 1)) {
+		return -1;
+	}
+	*vbus = (s1 & 0x01u) != 0;
+	*full = (s2 & 0x20u) != 0;
+	*charging = !*full && (s2 & 0x08u) != 0;
+	return 0;
+}
+
+int
+herolte_fg_init(void)
+{
+	int on = 1;
+	PE_parse_boot_argn("a50fg", &on, sizeof(on));
+	if (!on) {
+		printf("A50 BATTERY: off (a50fg=0)\n");
+		return -1;
+	}
+	ab_top = ml_io_map(A50_TOP_PINCTRL_PA, 0x1000);
+	ab_i2c = ml_io_map(A50_I2C1_PA, 0x1000);
+	if (!ab_top || !ab_i2c) {
+		printf("A50 BATTERY: mapping failed\n");
+		ab_i2c = 0;
+		return -1;
+	}
+	printf("A50 BATTERY: before: gpp0 con=%#x pud=%#x i2c con=%#x stat=%#x lc=%#x\n",
+	    ab_rd(ab_top, A50_GPP0 + PIN_CON), ab_rd(ab_top, A50_GPP0 + PIN_PUD),
+	    ab_rd(ab_i2c, IICCON), ab_rd(ab_i2c, IICSTAT), ab_rd(ab_i2c, IICLC));
+	/* i2c1_bus: gpp0-2 (SDA), gpp0-3 (SCL) function 2, no pull. */
+	ab_set_field(ab_top, A50_GPP0 + PIN_PUD, 2, 0);
+	ab_set_field(ab_top, A50_GPP0 + PIN_PUD, 3, 0);
+	ab_set_field(ab_top, A50_GPP0 + PIN_CON, 2, 2);
+	ab_set_field(ab_top, A50_GPP0 + PIN_CON, 3, 2);
+
+	uint16_t id = 0, soc = 0, vbat = 0, cur = 0;
+	if (!ab_word(FG_DEVICE_ID, &id) || !ab_word(FG_SOC, &soc) || !ab_word(FG_VBAT, &vbat) ||
+	    !ab_word(FG_CURRENT, &cur)) {
+		printf("A50 BATTERY: SM5713 fuel gauge not answering\n");
+		ab_i2c = 0;
+		return -1;
+	}
+	int vbus = 0, charging = 0, full = 0;
+	int chg = a50_charger_read(&vbus, &charging, &full);
+	unsigned tenths = ab_soc_tenths(soc);
+	printf("A50 BATTERY: SM5713 id %#x, SOC %#x = %u.%u%%, VBAT %#x = %u mV, current %#x = %d mA; "
+	    "charger %s vbus=%d charging=%d full=%d\n", id, soc, tenths / 10, tenths % 10, vbat, ab_mv(vbat),
+	    cur, ab_ma(cur), chg == 0 ? "read" : "NOT read", vbus, charging, full);
+	return 0;
+}
+
+int
+herolte_fg_read(unsigned *percent, unsigned *mv, int *ma, unsigned *rem_mah, unsigned *full_mah)
+{
+	uint16_t soc, vbat, cur;
+	if (ab_i2c == 0 || !ab_word(FG_SOC, &soc) || !ab_word(FG_VBAT, &vbat) || !ab_word(FG_CURRENT, &cur)) {
+		return -1;
+	}
+	unsigned tenths = ab_soc_tenths(soc);
+	*percent = (tenths + 5) / 10;
+	*mv = ab_mv(vbat);
+	*ma = ab_ma(cur);
+	*full_mah = A50_BATTERY_MAH;
+	*rem_mah = A50_BATTERY_MAH * tenths / 1000;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_A50 */
