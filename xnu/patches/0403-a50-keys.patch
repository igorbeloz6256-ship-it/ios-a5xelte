  * 0x10580000, Power GPA2 pin 4, Volume Up/Down and Home GPA0 pins 3/4/5,
  * active low.  S-Boot reads them too, so their mux is already set; the two
  * DAT registers are sampled together (bits 0-7 GPA0, 8-15 GPA2).
+ *
+ * A50 (Galaxy A50, Exynos 9610, exynos9610-a50_common.dtsi gpio_keys): ALIVE
+ * pinctrl_0 at 0x11850000, all three keys on GPA1 (bank +0x40): Power pin 7,
+ * Volume Up pin 5, Volume Down pin 6, function 0xf (EINT), active low. No
+ * Home key. Same read-only polling of one DAT register.
  */
 #if defined(ARM64_BOARD_CONFIG_A5XELTE)
 #include <sys/param.h>
@@ -23,7 +28,14 @@
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern void sweet_hid_key(int key, int down);
 
-#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+#if defined(ARM64_BOARD_CONFIG_A50)
+/* pinctrl-exynos-arm64.c exynos9610_pin_banks0: etc0 0x000, gpa0 0x020,
+ * gpa1 0x040, gpa2 0x060, gpq0 0x080 (TWRP's debugfs lists the same order). */
+#define A5_ALIVE_PA 0x11850000u
+#define A5_GPA1_CON 0x40u
+#define A5_GPA1_DAT 0x44u
+#define A5_GPA1_PUD 0x48u
+#elif defined(ARM64_BOARD_CONFIG_HEROLTE)
 #define A5_ALIVE_PA 0x10580000u
 #define A5_GPA0_CON 0x00u
 #define A5_GPA0_DAT 0x04u
@@ -60,7 +72,14 @@ a5_keys_wait(void)
 }
 
 /* Key order of sweet_hid_key(): power, volume up, volume down, home. */
-#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+#if defined(ARM64_BOARD_CONFIG_A50)
+static uint16_t
+a5_keys_sample(void)
+{
+	return (uint16_t)(a5_keys_read(A5_GPA1_DAT) & 0xff);
+}
+static const uint8_t a5_key_pins[3] = {7, 5, 6};
+#elif defined(ARM64_BOARD_CONFIG_HEROLTE)
 static uint16_t
 a5_keys_sample(void)
 {
@@ -96,7 +115,7 @@ a5_keys_thread(void *arg, wait_result_t result)
 			repeated = 0;
 		}
 		if (repeated == 2 && stable != sample) {
-			for (unsigned key = 0; key < 4; key++) {
+			for (unsigned key = 0; key < sizeof(a5_key_pins); key++) {
 				uint16_t bit = (uint16_t)(1u << a5_key_pins[key]);
 				if ((stable ^ sample) & bit) {
 					int down = !(sample & bit);
@@ -133,6 +152,12 @@ a5xelte_keys_init(void)
 		printf("A5XELTE KEYS: ALIVE mapping failed\n");
 		return;
 	}
+#if defined(ARM64_BOARD_CONFIG_A50)
+	/* Pins 5-7 should read function 0xf (EINT): con & 0xfff00000 == 0xfff00000. */
+	printf("A5XELTE KEYS: A50 GPA1 con=%#x dat=%#x pud=%#x (read only)\n",
+	    a5_keys_read(A5_GPA1_CON), a5_keys_read(A5_GPA1_DAT),
+	    a5_keys_read(A5_GPA1_PUD));
+#else
 #if defined(ARM64_BOARD_CONFIG_HEROLTE)
 	printf("A5XELTE KEYS: GPA0 con=%#x dat=%#x pud=%#x (read only)\n",
 	    a5_keys_read(A5_GPA0_CON), a5_keys_read(A5_GPA0_DAT),
@@ -141,6 +166,7 @@ a5xelte_keys_init(void)
 	printf("A5XELTE KEYS: GPA2 con=%#x dat=%#x pud=%#x (read only)\n",
 	    a5_keys_read(A5_GPA2_CON), a5_keys_read(A5_GPA2_DAT),
 	    a5_keys_read(A5_GPA2_PUD));
+#endif
 	kern_return_t kr = kernel_thread_start(a5_keys_thread, NULL, &thread);
 	if (kr == KERN_SUCCESS) {
 		thread_deallocate(thread);
