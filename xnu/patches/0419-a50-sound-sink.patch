+/*
+ * Step 3 of sound (boot-arg a50sound=1): /dev/hakios-audio, for HakiosAudio.driver in mediaserverd (gpu/hakios-audio,
+ * the S7's plug-in as it is): whole frames of 16-bit stereo at 48 kHz, never waited for (the writer is the HAL's
+ * real-time thread). RDMA0 loops over a ring of 64 KB in ABOX_RMEM all the time; where it reads is RDMA0 STATUS,
+ * OFFSET (28:16) + CNT (12:0) in 16-byte units (xnu23's polls fit that and 48 kHz exactly). A write that (re)starts a
+ * stream lands SOUND_LEAD ahead of that position and the next ones follow on; what would be further ahead than
+ * SOUND_MAX_FILL is dropped. A thread zeroes what has been played, so a stream that stops leaves silence, and keeps
+ * TFA9872 on while there is sound (off SOUND_AMP_IDLE_S after the last sample that was not 0).
+ * Volume: iOS scales the samples itself (the plug-in's control stays at its top; HAKIOS_AUDIO_SET_VOLUME is taken in
+ * 6 dB steps and for mute all the same). There is no speaker protection here (it is ABOX firmware) and xnu23's
+ * -24 dBFS tone was already loud, so everything is as_shift x 6 dB under full scale (a50sound=1: 12 dB).
+ */
+#define SOUND_RING_PA           0xebbe0000u     /* 64 KB of ABOX_RMEM below the tone's buffer */
+#define SOUND_RING_BYTES        0x10000u        /* 341 ms */
+#define SOUND_LEAD              0x1800u         /* 32 ms */
+#define SOUND_MAX_FILL          0x8000u         /* 171 ms */
+#define SOUND_GAP_MS            250u            /* a write this much later than the one before starts over */
+#define SOUND_BUSY_MS           2000u           /* zeroing every 5 ms this long after a write, every 50 ms after */
+#define SOUND_AMP_IDLE_S        10u
+#define SOUND_STATS_S           10u
+
+struct as_volume {
+	uint32_t below;         /* eighths of a dB under the loudest */
+	uint32_t muted;
+};
+#define AS_SET_VOLUME           _IOW('r', 1, struct as_volume)          /* HAKIOS_AUDIO_SET_VOLUME */
+#define AS_PLUGIN_SAYS          _IOW('r', 2, char[200])                 /* the plug-in's words (its stderr goes nowhere) */
+
+static LCK_GRP_DECLARE(as_grp, "a50_sound");
+static LCK_MTX_DECLARE(as_lock, &as_grp);
+static vm_offset_t as_abox, as_ring;
+static volatile bool as_ready;                  /* the path runs, writes go to the ring */
+static volatile bool as_amp_on;
+static volatile bool as_muted;
+static volatile unsigned as_below_shift;        /* HAKIOS_AUDIO_SET_VOLUME, in 6 dB steps */
+static unsigned as_shift = 2;                   /* the cap, in 6 dB steps */
+static uint32_t as_w;                           /* ring offset of the next frame written (as_lock) */
+static volatile uint64_t as_last_write, as_heard;       /* mach times: a write; a sample that was not 0 */
+static uint64_t as_gap_abs, as_busy_abs, as_idle_abs, as_stats_abs;
+static volatile uint64_t as_frames, as_dropped, as_restarts;
+static int as_chan;
+
+static uint32_t
+as_pos(void)
+{
+	uint32_t st = au_rd(as_abox, RDMA0 + RDMA_STATUS);
+	return ((((st >> 16) & 0x1fffu) + (st & 0x1fffu)) * 16u) & (SOUND_RING_BYTES - 1);
+}
+
+static uint64_t
+as_abs_ms(uint64_t ms)
+{
+	uint64_t t;
+	nanoseconds_to_absolutetime(ms * NSEC_PER_MSEC, &t);
+	return t;
+}
+
+static int
+as_open(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	char name[32];
+	proc_selfname(name, (int)sizeof(name));
+	printf("A50 SOUND: /dev/hakios-audio opened by %s\n", name);
+	return 0;
+}
+
+static int
+as_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+as_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint32_t frames[256];
+	int error = 0;
+	bool loud = false;
+
+	lck_mtx_lock(&as_lock);
+	while (uio_resid(uio) >= 4) {
+		user_ssize_t bytes = uio_resid(uio);
+		bytes = (bytes > (user_ssize_t)sizeof(frames) ? (user_ssize_t)sizeof(frames) : bytes) & ~(user_ssize_t)3;
+		error = uiomove((caddr_t)frames, (int)bytes, uio);
+		if (error) {
+			break;
+		}
+		uint32_t n = (uint32_t)(bytes / 4), done = 0;
+		if (as_ready) {
+			uint64_t now = mach_absolute_time();
+			uint32_t p = as_pos(), fill = (as_w - p) & (SOUND_RING_BYTES - 1);
+			unsigned shift = as_shift + as_below_shift;
+			if (as_last_write == 0 || now - as_last_write > as_gap_abs || fill > SOUND_MAX_FILL) {
+				as_restarts += as_last_write != 0;
+				as_w = (p + SOUND_LEAD) & (SOUND_RING_BYTES - 1);
+				fill = SOUND_LEAD;
+			}
+			while (done < n && fill + 4 <= SOUND_MAX_FILL) {
+				int32_t left = (int16_t)(frames[done] & 0xffffu), right = (int16_t)(frames[done] >> 16);
+				if (as_muted) {
+					left = 0;
+					right = 0;
+				}
+				left >>= shift;
+				right >>= shift;
+				if ((left | right) != 0) {
+					loud = true;
+				}
+				*(volatile uint32_t *)(as_ring + as_w) = (uint32_t)(uint16_t)left | ((uint32_t)(uint16_t)right << 16);
+				as_w = (as_w + 4) & (SOUND_RING_BYTES - 1);
+				fill += 4;
+				done++;
+			}
+			as_last_write = now;
+		}
+		as_frames += done;
+		as_dropped += n - done;
+	}
+	if (loud) {
+		as_heard = mach_absolute_time();
+	}
+	lck_mtx_unlock(&as_lock);
+	if (loud && !as_amp_on) {
+		thread_wakeup(&as_chan);
+	}
+	return error;
+}
+
+static int
+as_ioctl(__unused dev_t dev, u_long command, caddr_t data, __unused int flags, __unused struct proc *p)
+{
+	if (command == AS_SET_VOLUME) {
+		struct as_volume v;
+		memcpy(&v, data, sizeof(v));
+		as_muted = v.muted != 0;
+		as_below_shift = MIN(v.below / 48u, 15u - as_shift);
+		printf("A50 SOUND: volume %u.%u dB under the top%s\n", v.below / 8u, v.below % 8u * 10u / 8u,
+		    v.muted ? ", muted" : "");
+		return 0;
+	}
+	if (command == AS_PLUGIN_SAYS) {
+		data[199] = '\0';
+		printf("A50 SOUND: plug-in: %s", data);
+		return 0;
+	}
+	return ENOTTY;
+}
+
+static const struct cdevsw as_cdevsw = {
+	.d_open = as_open, .d_close = as_close, .d_read = eno_rdwrt, .d_write = as_write,
+	.d_ioctl = as_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_type = 0
+};
+
+static void
+as_stats(const char *why)
+{
+	printf("A50 SOUND: %s: %llu frames, %llu dropped, %llu restarts; RDMA0 CTRL0 %#x STATUS %#x, UAIF2 CTRL0 %#x "
+	    "STATUS %#x; amplifier %s\n", why, as_frames, as_dropped, as_restarts, au_rd(as_abox, RDMA0 + RDMA_CTRL0),
+	    au_rd(as_abox, RDMA0 + RDMA_STATUS), au_rd(as_abox, ABOX_UAIF2_CTRL0), au_rd(as_abox, ABOX_UAIF2_STATUS),
+	    as_amp_on ? "on" : "off");
+}
+
+static void
+as_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	au_quiet = true;
+	as_gap_abs = as_abs_ms(SOUND_GAP_MS);
+	as_busy_abs = as_abs_ms(SOUND_BUSY_MS);
+	as_idle_abs = as_abs_ms(SOUND_AMP_IDLE_S * 1000ull);
+	as_stats_abs = as_abs_ms(SOUND_STATS_S * 1000ull);
+
+	/* The node first: mediaserverd opens it as it starts (and again on each write until it is there). */
+	int major = cdevsw_add(-1, &as_cdevsw);
+	bool node = false;
+	for (unsigned i = 0; major >= 0 && !node && i < 30; i++) {
+		node = devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "hakios-audio") != NULL;
+		if (!node) {
+			au_sleep_ms(1000);
+		}
+	}
+	printf("A50 SOUND: /dev/hakios-audio %s (major %d), %u dB under full scale\n", node ? "made" : "NOT made", major,
+	    as_shift * 6u);
+	if (!node) {
+		return;
+	}
+
+	/* Then the path, as xnu23 played its tone: TFA9872 found (and left powered down), ring zeroed, RDMA0 running. */
+	struct au_maps m;
+	as_ring = ml_io_map(SOUND_RING_PA, SOUND_RING_BYTES);
+	if (!au_map_path(&m) || !as_ring) {
+		printf("A50 SOUND: mapping failed\n");
+		return;
+	}
+	as_abox = m.abox;
+	au_probe_tfa();
+	if (!au_tfa_ok) {
+		printf("A50 SOUND: no TFA9872, no sound\n");
+		return;
+	}
+	for (uint32_t off = 0; off < SOUND_RING_BYTES; off += 4) {
+		*(volatile uint32_t *)(as_ring + off) = 0;
+	}
+	*(volatile uint32_t *)(as_ring + SOUND_RING_BYTES - 4) = TONE_CREST;
+	__asm__ volatile ("dsb osh" ::: "memory");
+	uint32_t check = *(volatile uint32_t *)(as_ring + SOUND_RING_BYTES - 4);
+	*(volatile uint32_t *)(as_ring + SOUND_RING_BYTES - 4) = 0;
+	if (check != TONE_CREST) {
+		printf("A50 SOUND: the ring at %#x does not hold what was written (%#x), no sound\n", SOUND_RING_PA, check);
+		return;
+	}
+	au_path_on(&m, SOUND_RING_PA, SOUND_RING_BYTES, true);
+	au_update_logged("ABOX UAIF2_CTRL0 SPK_ENABLE", as_abox, ABOX_UAIF2_CTRL0, 1u, 1u);
+	uint32_t zeroed = as_pos() & ~3u;
+	as_ready = true;
+	as_stats("ready");
+
+	uint64_t told = mach_absolute_time(), told_frames = 0;
+	for (;;) {
