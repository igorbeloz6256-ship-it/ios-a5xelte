+
+/* One register, the log out just before it is read: if the read hangs, the last line names it. */
+static uint32_t
+au_read_logged(const char *what, vm_offset_t base, uint32_t off)
+{
+	printf("A50 AUDIO: read %s +%#x next\n", what, off);
+	au_kick(400);
+	uint32_t v = au_rd(base, off);
+	printf("A50 AUDIO: %s +%#x = %#x\n", what, off, v);
+	return v;
+}
+
+/* The same for a write, then what the register reads back. */
+static void
+au_write_logged(const char *what, vm_offset_t base, uint32_t off, uint32_t v)
+{
+	printf("A50 AUDIO: write %s +%#x = %#x next\n", what, off, v);
+	au_kick(400);
+	au_wr(base, off, v);
+	printf("A50 AUDIO: %s +%#x now %#x\n", what, off, au_rd(base, off));
+}
+
+static void
+au_read_table(vm_offset_t base, const struct au_reg *regs, unsigned n)
+{
+	for (unsigned i = 0; i < n; i++) {
+		(void)au_read_logged(regs[i].name, base, regs[i].off);
