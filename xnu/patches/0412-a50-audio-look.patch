diff --git a/bsd/dev/a50_audio.c b/bsd/dev/a50_audio.c
new file mode 100644
index 0000000..8b36ebd
--- /dev/null
+++ b/bsd/dev/a50_audio.c
@@ -0,0 +1,301 @@
+/*
+ * Galaxy A50 (SM-A505FN, Exynos 9610) sound, step 1: a look, nothing set. 30 s after boot (boot-arg a50audio=1) the
+ * kernel logs what the speaker path's hardware looks like as iOS finds it, for the next steps (A50_PROGRESS.md, "Звук"):
+ *  - CMU_TOP 0x12100000: CLKCMU_DISPAUD_AUD/CPU (mux 0x1030/0x1034, div 0x1838/0x183c, gate 0x2038/0x203c);
+ *  - CMU_DISPAUD 0x14980000: PLL_AUD (CON0 0x160: ENABLE 31, STABLE 29, M 25:16, P 13:8, S 2:0; CON3 0x16c K),
+ *    muxes, dividers (AUDIF 0x1800, CPU 0x180c, CPU_ACLK 0x1810, UAIF2 0x182c), gates 0x2000-0x20bc, QCH 0x3000-0x3060
+ *    (drivers/soc/samsung/cal-if/exynos9610/cmucal-sfr.c);
+ *  - ABOX 0x14A50000 (sound/soc/samsung/abox/abox.h): system, routing, SPUS, UAIF0-4, timers, RDMA7, CPU PC; and the
+ *    ABOX SysMMU 0x14920000 (live DT: port-name "ABox") -- only when CMU_DISPAUD's ABOX ACLK (0x2020) and SMMU_ABOX
+ *    (0x20b0) gates are not held off by hand (MANUAL bit 20 with CG_VAL bit 21 clear): a block without its clock can
+ *    hang the bus;
+ *  - the TFA9872 amplifier at 0x34 on hsi2c_3 (0x11D10000, USI_0_CMGP_I2C, pins gpm2-0 SCL / gpm3-0 SDA function 3 of
+ *    pinctrl 0x11C20000; CMU_CMGP 0x11C00000: MUX_CMGP_I2C 0x1004, DIV 0x1804, gates 0x2018/0x201c/0x2044, QCH
+ *    0x3014): its revision (register 0x03, big-endian; TWRP read 0x3b first) and the first registers. HSI2C as
+ *    drivers/i2c/busses/i2c-exynos5.c: USI_CON 0xC4 = 0 (USI reset off), fast-mode timing fields at the largest
+ *    divider (100 kHz or less whatever the input clock), auto mode.
+ * Writes: the two pins' CON/PUD fields, the HSI2C controller, and TFA9872 register addresses only.
+ */
+#if defined(ARM64_BOARD_CONFIG_A50)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void a50_audio_start(void);
+
+#define CMU_TOP_PA              0x12100000u
+#define CMU_DISPAUD_PA          0x14980000u
+#define CMU_CMGP_PA             0x11c00000u
+#define ABOX_PA                 0x14a50000u
+#define SMMU_ABOX_PA            0x14920000u
+#define HSI2C3_PA               0x11d10000u
+#define CMGP_PINCTRL_PA         0x11c20000u
+#define GPM2                    0x040u
+#define GPM3                    0x060u
+#define TFA_ADDR                0x34u
+
+#define HSI2C_CTL               0x00u
+#define HSI2C_FIFO_CTL          0x04u
+#define HSI2C_TRAILING          0x08u
+#define HSI2C_INT_EN            0x20u
+#define HSI2C_INT_STAT          0x24u
+#define HSI2C_FIFO_STAT         0x30u
+#define HSI2C_TX_DATA           0x34u
+#define HSI2C_RX_DATA           0x38u
+#define HSI2C_CONF              0x40u
+#define HSI2C_AUTO_CONF         0x44u
+#define HSI2C_TIMEOUT           0x48u
+#define HSI2C_TRANS             0x50u
+#define HSI2C_FS1               0x60u
+#define HSI2C_FS2               0x64u
+#define HSI2C_FS3               0x68u
+#define HSI2C_ADDR              0x70u
+#define USI_CON                 0xc4u
+
+static vm_offset_t au_i2c;
+
+static uint32_t
+au_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+au_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/* Registers [first, last] of base, four to a line. */
+static void
+au_dump(const char *what, vm_offset_t base, uint32_t first, uint32_t last)
+{
+	for (uint32_t off = first; off <= last; off += 16) {
+		uint32_t v[4] = { 0, 0, 0, 0 };
+		for (unsigned i = 0; i < 4 && off + 4 * i <= last; i++) {
+			v[i] = au_rd(base, off + 4 * i);
+		}
+		printf("A50 AUDIO: %s +%#06x: %08x %08x %08x %08x\n", what, off, v[0], v[1], v[2], v[3]);
+	}
+}
+
+/* A CMU gate held off by hand: MANUAL (20) set, CG_VAL (21) clear. */
+static bool
+au_gated_off(uint32_t gate)
+{
+	return (gate & (1u << 20)) && !(gate & (1u << 21));
+}
+
+static void
+au_set_field(vm_offset_t base, uint32_t reg, unsigned pin, uint32_t value)
+{
+	uint32_t v = au_rd(base, reg);
+	au_wr(base, reg, (v & ~(0xfu << (4 * pin))) | ((value & 0xfu) << (4 * pin)));
+}
+
+/* As i2c-exynos5.c: USI reset off, soft reset, fast-mode timing at the largest divider, master, auto mode. */
+static void
+au_i2c_init(void)
+{
+	au_wr(au_i2c, USI_CON, 0);
+	au_wr(au_i2c, HSI2C_CTL, au_rd(au_i2c, HSI2C_CTL) | 0x80000000u);
+	delay(10);
+	au_wr(au_i2c, HSI2C_CTL, au_rd(au_i2c, HSI2C_CTL) & ~0x80000000u);
+	au_wr(au_i2c, HSI2C_TIMEOUT, au_rd(au_i2c, HSI2C_TIMEOUT) & ~0x80000000u);
+	au_wr(au_i2c, HSI2C_FS3, (au_rd(au_i2c, HSI2C_FS3) & ~0x00ff0000u) | (0xffu << 16));
+	au_wr(au_i2c, HSI2C_FS2, (au_rd(au_i2c, HSI2C_FS2) & ~0x000000ffu) | 0xfeu);
+	au_wr(au_i2c, HSI2C_FS1, (au_rd(au_i2c, HSI2C_FS1) & ~0x00ff0000u) | (0xffu << 16));
+	au_wr(au_i2c, HSI2C_CTL, 0x9u);                 /* I2C function mode, master */
+	au_wr(au_i2c, HSI2C_TRAILING, 0xfu);
+	au_wr(au_i2c, HSI2C_CONF, au_rd(au_i2c, HSI2C_CONF) | 0x80000000u);    /* auto mode */
+	au_wr(au_i2c, HSI2C_INT_EN, 0);
+}
+
+/* One message in auto mode (as herolte_battery.c); without stop the next one starts with a repeated START. */
+static bool
+au_message(bool receive, uint8_t *bytes, unsigned count, bool stop)
+{
+	uint32_t last = 0;
+	bool xfer_done = false;
+	unsigned done = 0;
+	au_wr(au_i2c, HSI2C_INT_STAT, au_rd(au_i2c, HSI2C_INT_STAT));
+	au_wr(au_i2c, HSI2C_FIFO_CTL, 3u | (receive ? (1u << 4) : (1u << 16)));
+	au_wr(au_i2c, HSI2C_ADDR, TFA_ADDR << 10);
+	au_wr(au_i2c, HSI2C_CTL, 9u | (receive ? 0x40u : 0x80u));
+	au_wr(au_i2c, HSI2C_INT_EN, 0xf80u | (receive ? 0x42u : 1u));
+	au_wr(au_i2c, HSI2C_AUTO_CONF, count | (receive ? 0x10000u : 0) | (stop ? 0x20000u : 0) | 0x80000000u);
+	for (unsigned us = 0; us < 50000; us++) {
+		uint32_t irq = au_rd(au_i2c, HSI2C_INT_STAT);
+		if (irq) {
+			last |= irq;
+			au_wr(au_i2c, HSI2C_INT_STAT, irq);
+		}
+		if (irq & 0xf00u) {
+			break;
+		}
+		if (irq & 0x80u) {
+			xfer_done = true;
+		}
+		if (receive) {
+			while (done < count && ((au_rd(au_i2c, HSI2C_FIFO_STAT) >> 16) & 0x7fu)) {
+				bytes[done++] = (uint8_t)au_rd(au_i2c, HSI2C_RX_DATA);
+			}
+		} else {
+			while (done < count && !(au_rd(au_i2c, HSI2C_FIFO_STAT) & (1u << 7))) {
+				au_wr(au_i2c, HSI2C_TX_DATA, bytes[done++]);
+			}
+		}
+		if (done == count && (xfer_done || (receive && stop))) {
+			au_wr(au_i2c, HSI2C_INT_EN, 0);
+			if (!stop) {
+				return true;
+			}
+			for (unsigned n = 0; n < 10000; n++) {
+				if (!(au_rd(au_i2c, HSI2C_TRANS) & (1u << 17))) {
+					return true;
+				}
+				delay(1);
+			}
+			break;
+		}
+		delay(1);
+	}
+	static unsigned errors_logged;
+	if (errors_logged++ < 8) {
+		printf("A50 AUDIO: TFA9872 %s %u/%u failed int=%#x trans=%#x fifo=%#x\n", receive ? "rx" : "tx", done, count,
+		    last, au_rd(au_i2c, HSI2C_TRANS), au_rd(au_i2c, HSI2C_FIFO_STAT));
+	}
+	au_wr(au_i2c, HSI2C_INT_EN, 0);
+	au_i2c_init();
+	return false;
+}
+
+/* TFA98xx registers are 16 bits, most significant byte first. */
+static bool
+au_tfa_read(uint8_t reg, uint16_t *value)
+{
+	uint8_t b[2];
+	if (au_message(false, &reg, 1, false) && au_message(true, b, 2, true)) {
+		*value = (uint16_t)((b[0] << 8) | b[1]);
+		return true;
+	}
+	return false;
+}
+
+static void
+au_probe_tfa(void)
+{
+	vm_offset_t cmgp = ml_io_map(CMU_CMGP_PA, 0x4000), pins = ml_io_map(CMGP_PINCTRL_PA, 0x1000);
+	au_i2c = ml_io_map(HSI2C3_PA, 0x1000);
+	if (!cmgp || !pins || !au_i2c) {
+		printf("A50 AUDIO: CMGP mapping failed\n");
+		return;
+	}
+	uint32_t ipclk = au_rd(cmgp, 0x2018), pclk = au_rd(cmgp, 0x201c), rst = au_rd(cmgp, 0x2044);
+	printf("A50 AUDIO: CMU_CMGP mux_i2c=%#x div_i2c=%#x gates ipclk=%#x pclk=%#x rstnsync=%#x qch=%#x\n",
+	    au_rd(cmgp, 0x1004), au_rd(cmgp, 0x1804), ipclk, pclk, rst, au_rd(cmgp, 0x3014));
+	printf("A50 AUDIO: gpm2 con=%#x dat=%#x pud=%#x gpm3 con=%#x dat=%#x pud=%#x\n", au_rd(pins, GPM2),
+	    au_rd(pins, GPM2 + 4), au_rd(pins, GPM2 + 8), au_rd(pins, GPM3), au_rd(pins, GPM3 + 4), au_rd(pins, GPM3 + 8));
+	if (au_gated_off(ipclk) || au_gated_off(pclk)) {
+		printf("A50 AUDIO: hsi2c_3's clocks are off: TFA9872 not asked\n");
+		return;
+	}
+	printf("A50 AUDIO: hsi2c_3 as found: ctl=%#x conf=%#x fs1=%#x fs2=%#x fs3=%#x usi_con=%#x\n", au_rd(au_i2c,
+	    HSI2C_CTL), au_rd(au_i2c, HSI2C_CONF), au_rd(au_i2c, HSI2C_FS1), au_rd(au_i2c, HSI2C_FS2), au_rd(au_i2c,
+	    HSI2C_FS3), au_rd(au_i2c, USI_CON));
+	/* hsi2c3_bus: gpm2-0 (SCL), gpm3-0 (SDA) function 3, no pull. */
+	au_set_field(pins, GPM2 + 8, 0, 0);
+	au_set_field(pins, GPM3 + 8, 0, 0);
+	au_set_field(pins, GPM2, 0, 3);
+	au_set_field(pins, GPM3, 0, 3);
+	au_i2c_init();
+	uint16_t rev = 0;
+	if (!au_tfa_read(0x03, &rev)) {
+		printf("A50 AUDIO: TFA9872 at 0x34 not answering\n");
+		return;
+	}
+	printf("A50 AUDIO: TFA9872 revision %#06x\n", rev);
+	for (uint8_t reg = 0x00; reg < 0x20; reg += 8) {
+		uint16_t v[8] = { 0 };
+		for (unsigned i = 0; i < 8; i++) {
+			(void)au_tfa_read((uint8_t)(reg + i), &v[i]);
+		}
+		printf("A50 AUDIO: TFA9872 %#04x: %04x %04x %04x %04x %04x %04x %04x %04x\n", reg, v[0], v[1], v[2], v[3],
+		    v[4], v[5], v[6], v[7]);
+	}
+}
+
+static int au_sleep_chan;
+
+static void
+au_probe(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(30, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&au_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+	vm_offset_t top = ml_io_map(CMU_TOP_PA, 0x4000), dispaud = ml_io_map(CMU_DISPAUD_PA, 0x4000);
+	if (!top || !dispaud) {
+		printf("A50 AUDIO: CMU mapping failed\n");
+		return;
+	}
+	uint32_t top_aud_gate = au_rd(top, 0x2038);
+	printf("A50 AUDIO: CMU_TOP dispaud_aud mux=%#x div=%#x gate=%#x; dispaud_cpu mux=%#x div=%#x gate=%#x\n",
+	    au_rd(top, 0x1030), au_rd(top, 0x1838), top_aud_gate, au_rd(top, 0x1034), au_rd(top, 0x183c), au_rd(top, 0x203c));
+	uint32_t pll = au_rd(dispaud, 0x160);
+	printf("A50 AUDIO: PLL_AUD con0=%#x (enable %u stable %u M %u P %u S %u) con3=%#x locktime=%#x\n", pll, pll >> 31,
+	    (pll >> 29) & 1, (pll >> 16) & 0x3ff, (pll >> 8) & 0x3f, pll & 7, au_rd(dispaud, 0x16c), au_rd(dispaud, 0x0));
+	au_dump("CMU_DISPAUD", dispaud, 0x100, 0x16c);
+	au_dump("CMU_DISPAUD", dispaud, 0x800, 0x800);
+	au_dump("CMU_DISPAUD", dispaud, 0x1000, 0x1030);
+	au_dump("CMU_DISPAUD", dispaud, 0x1800, 0x1840);
+	au_dump("CMU_DISPAUD", dispaud, 0x2000, 0x20bc);
+	au_dump("CMU_DISPAUD", dispaud, 0x3000, 0x3060);
+	uint32_t aclk = au_rd(dispaud, 0x2020), smmu = au_rd(dispaud, 0x20b0);
+	if (au_gated_off(top_aud_gate) || au_gated_off(aclk)) {
+		printf("A50 AUDIO: ABOX's clock is held off (top %#x aclk %#x): ABOX not read\n", top_aud_gate, aclk);
+	} else {
+		vm_offset_t abox = ml_io_map(ABOX_PA, 0x4000);
+		if (abox) {
+			printf("A50 AUDIO: ABOX ip_index %#x version %#x\n", au_rd(abox, 0x0), au_rd(abox, 0x4));
+			au_dump("ABOX", abox, 0x0, 0x4c);
+			au_dump("ABOX", abox, 0x200, 0x20c);
+			au_dump("ABOX", abox, 0x280, 0x28c);
+			au_dump("ABOX", abox, 0x500, 0x56c);
+			au_dump("ABOX", abox, 0x600, 0x61c);
+			au_dump("ABOX", abox, 0x1700, 0x173c);
+			au_dump("ABOX", abox, 0x2c3c, 0x2c4c);
+		}
+	}
+	if (au_gated_off(smmu)) {
+		printf("A50 AUDIO: SMMU_ABOX's clock is held off (%#x): not read\n", smmu);
+	} else {
+		vm_offset_t mmu = ml_io_map(SMMU_ABOX_PA, 0x1000);
+		if (mmu) {
+			au_dump("SMMU_ABOX", mmu, 0x0, 0x7c);
+		}
+	}
+	au_probe_tfa();
+	printf("A50 AUDIO: look done\n");
+}
+
+void
+a50_audio_start(void)
+{
+	int on = 0;
+	thread_t thread;
+	PE_parse_boot_argn("a50audio", &on, sizeof(on));
+	if (on && kernel_thread_start(au_probe, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_A50 */
