+/* tfa_run_startup without the DSP parts: init, device and profile settings, out of power-down, MANSCONF. */
+static void
+au_tfa_power_up(void)
+{
+	uint16_t rev = 0, key = 0;
+	printf("A50 AUDIO: TFA9872 power-up next\n");
+	au_kick(400);
+	au_tfa_status("before");
+	(void)au_tfa_write(0x00, 0x0002);       /* I2CR: registers to their defaults */
+	delay(10000);
+	(void)au_tfa_read(0x03, &rev);
+	/* Unlock key 1 and 2 (tfa9872_specific, tfa98xx_key2). */
+	(void)au_tfa_write(0x0f, 0x5a6b);
+	(void)au_tfa_read(0xfb, &key);
+	(void)au_tfa_write(0xa0, key ^ 0x005a);
+	(void)au_tfa_write(0x0f, 0x5a6b);
+	(void)au_tfa_bf(TFA_MTPK, 0x5a);
+	(void)au_tfa_write(0x0f, 0x0000);
+	if ((rev & 0x0fffu) == 0x0b72) {
+		for (unsigned i = 0; i < sizeof(au_tfa_n1b2_regs) / sizeof(au_tfa_n1b2_regs[0]); i++) {
+			(void)au_tfa_write((uint8_t)au_tfa_n1b2_regs[i][0], au_tfa_n1b2_regs[i][1]);
+		}
+	} else {
+		printf("A50 AUDIO: TFA9872 revision %#06x: no register list\n", rev);
+	}
+	(void)au_tfa_bf(TFA_MANAOOSC, 1);
+	uint16_t b0 = 0;
+	if (au_tfa_read(0xb0, &b0)) {
+		(void)au_tfa_write(0xb0, b0 | (1u << 3));       /* bypass OVP */
+	}
+	for (unsigned i = 0; i < sizeof(au_tfa_dev_fields) / sizeof(au_tfa_dev_fields[0]); i++) {
+		(void)au_tfa_bf(au_tfa_dev_fields[i][0], au_tfa_dev_fields[i][1]);
+	}
+	au_tfa_status("set up");
+	(void)au_tfa_bf(TFA_PWDN, 0);
+	(void)au_tfa_bf(TFA_MANSCONF, 1);
+	(void)au_tfa_bf(TFA_INTSMUTE, 0);
+	au_kick(10);
+}
+
+static void
+au_tfa_power_down(void)
+{
+	(void)au_tfa_bf(TFA_INTSMUTE, 1);
+	(void)au_tfa_bf(TFA_MANSCONF, 0);
+	(void)au_tfa_bf(TFA_PWDN, 1);
+	au_tfa_status("powered down");
+}
