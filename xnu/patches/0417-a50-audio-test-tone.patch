+static bool
+au_tfa_write(uint8_t reg, uint16_t value)
+{
+	uint8_t b[3] = { reg, (uint8_t)(value >> 8), (uint8_t)value };
+	bool ok = au_message(false, b, 3, true);
+	printf("A50 AUDIO: TFA9872 write %#04x = %#06x%s\n", reg, value, ok ? "" : " FAILED");
+	return ok;
+}
+
+/* A bit field as tfa_set_bf: read, replace the field, write. */
+static bool
+au_tfa_bf(uint16_t field, uint16_t value)
+{
+	uint8_t reg = (uint8_t)(field >> 8);
+	unsigned pos = (field >> 4) & 0xfu, len = (field & 0xfu) + 1;
+	uint16_t mask = (uint16_t)(((1u << len) - 1) << pos), v;
+	if (!au_tfa_read(reg, &v)) {
+		printf("A50 AUDIO: TFA9872 read %#04x for field %#06x FAILED\n", reg, field);
+		return false;
+	}
+	return au_tfa_write(reg, (uint16_t)((v & ~mask) | ((uint16_t)(value << pos) & mask)));
+}
+
+static void
+au_tfa_status(const char *when)
+{
+	uint16_t s[5] = { 0 };
+	static const uint8_t regs[5] = { 0x00, 0x10, 0x11, 0x13, 0x14 };
+	for (unsigned i = 0; i < 5; i++) {
+		(void)au_tfa_read(regs[i], &s[i]);
+	}
+	printf("A50 AUDIO: TFA9872 %s: 00=%04x 10=%04x 11=%04x 13=%04x 14=%04x (MANSTATE %u)\n", when, s[0], s[1], s[2],
+	    s[3], s[4], (s[4] >> 3) & 0xfu);
+}
