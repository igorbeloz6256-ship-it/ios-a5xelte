+static void
+au_tone_poll(vm_offset_t abox, unsigned i)
+{
+	printf("A50 AUDIO: tone %u: RDMA0 CTRL0 %#x STATUS %#x, UAIF2 CTRL0 %#x STATUS %#x\n", i,
+	    au_rd(abox, RDMA0 + RDMA_CTRL0), au_rd(abox, RDMA0 + RDMA_STATUS), au_rd(abox, ABOX_UAIF2_CTRL0),
+	    au_rd(abox, ABOX_UAIF2_STATUS));
+}
+
+/* Step 32: RDMA0 -> SPUS OUT0 -> SIFS1 -> UAIF2 with a 1 kHz tone; step 64 turns the amplifier on meanwhile. */
+static void
+au_tone(void)
+{
+	vm_offset_t top = ml_io_map(CMU_TOP_PA, 0x4000), dispaud = ml_io_map(CMU_DISPAUD_PA, 0x4000);
+	vm_offset_t abox = ml_io_map(ABOX_PA, 0x4000), pmu = ml_io_map(PMU_PA + 0x3000, 0x1000);
+	vm_offset_t gpio = ml_io_map(GPIO_DISPAUD_PA, 0x1000), buf = 0;
+	if (!top || !dispaud || !abox || !pmu || !gpio) {
+		printf("A50 AUDIO: tone mapping failed\n");
+		return;
+	}
+	if (kmem_alloc_contig(kernel_map, &buf, TONE_ALLOC, PAGE_MASK, 0, 0, KMA_DATA | KMA_ZERO,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("A50 AUDIO: no contiguous memory for the tone\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)buf);
+	uint64_t pa = ptoa_64(pn);
+	if (!pn || pa + TONE_ALLOC > 0x100000000ULL) {
+		printf("A50 AUDIO: tone buffer at %#llx, out of ABOX's reach\n", pa);
+		return;
+	}
+	int16_t *samples = (int16_t *)buf;
+	for (unsigned i = 0; i < TONE_BYTES / 4; i++) {
+		samples[2 * i] = samples[2 * i + 1] = au_sine[i % 48];
+	}
+	flush_dcache64((addr64_t)pa, TONE_BYTES, TRUE);
+	uint32_t pa32 = (uint32_t)pa;
+	printf("A50 AUDIO: tone buffer pa %#x, %u bytes\n", pa32, TONE_BYTES);
+
+	/* Clocks: the audio side and ABOX's bus (if step 2 did not), UAIF2's BCLK, ABOX's path to DRAM, its GPIO. */
+	if (!(au_mask & 2)) {
+		au_clock_on("TOP GATE_CLKCMU_DISPAUD_AUD", top, 0x2038, 0);
+		au_clock_on("ABOX ACLK", dispaud, 0x2020, 0x3014);
+	}
+	au_clock_on("GAT ABOX BCLK_UAIF2", dispaud, 0x2008, 0x3020);
+	au_clock_on("GAT RSTNSYNC AUD_UAIF2", dispaud, 0x2018, 0);
+	au_clock_on("GAT LHS_AXI_D_ABOX", dispaud, 0x2078, 0x304c);
+	au_clock_on("GAT PPMU_ABOX ACLK", dispaud, 0x2084, 0x3050);
+	au_clock_on("GAT PPMU_ABOX PCLK", dispaud, 0x2088, 0);
+	au_clock_on("GAT GPIO_DISPAUD", dispaud, 0x206c, 0x3040);
+	/* AUDIF 1179.648 / 48 = 24.576 MHz (Linux AUDIF_RATE_HZ), UAIF2 BCLK / 16 = 1.536 MHz, from the divider. */
+	au_update_logged("DIV_CLK_AUD_AUDIF", dispaud, 0x1800, 0x1ffu, 47);
+	au_update_logged("DIV_CLK_AUD_UAIF2", dispaud, 0x182c, 0x1ffu, 15);
+	au_update_logged("MUX_CLK_AUD_UAIF2", dispaud, 0x1018, 1u, 0);
+
+	/* Audio pads out of retention, UAIF2 pins (aud_i2s2_bus: gpb2-0..3 function 2, pull-down). */
+	au_update_logged("PMU PAD_RETENTION_ABOX_OPTION", pmu, PMU_PAD_RET_ABOX & 0xfffu, 0x10000000u, 0x10000000u);
+	(void)au_read_logged("GPIO gpb0 CON", gpio, 0x000);
+	(void)au_read_logged("GPIO gpb1 CON", gpio, 0x020);
+	au_update_logged("GPIO gpb2 CON", gpio, GPB2, 0xffffu, 0x2222u);
+	au_update_logged("GPIO gpb2 PUD", gpio, GPB2 + 8, 0xffffu, 0x1111u);
+
+	/* ABOX: DRAM on, UAIF2 BCLK Q-channel kept running, UAIF2 master I2S 16-bit stereo, routing. */
+	au_update_logged("ABOX SYSPOWER_CTRL", abox, ABOX_SYSPOWER_CTRL, 1u, 1u);
+	au_update_logged("ABOX QCHANNEL_DISABLE", abox, ABOX_QCHANNEL_DISABLE, 1u << 4, 1u << 4);
+	au_update_logged("ABOX UAIF2_CTRL0", abox, ABOX_UAIF2_CTRL0, 0x5u, 0x4u);      /* MODE master, SPK off */
+	/* FORMAT 0x9 (16 bits, 2 ch), BCLK_POLARITY 1 (NB_NF), I2S, SLOT_MAX 1, SBIT_MAX 15. */
+	au_update_logged("ABOX UAIF2_CTRL1", abox, ABOX_UAIF2_CTRL1, 0xffffffffu, 0x0984f000u);
+	au_update_logged("ABOX ROUTE_CTRL0", abox, ABOX_ROUTE_CTRL0, 0xf00u, 0x200u);   /* UAIF2 SPK = SIFS1 */
+	au_update_logged("ABOX SPUS_CTRL0", abox, ABOX_SPUS_CTRL0, 0xfu, 0);            /* RDMA0 -> OUT0 -> SIFS1 */
+	au_update_logged("ABOX SPUS_CTRL1", abox, ABOX_SPUS_CTRL1, 0x70000u, 0);        /* SIFS1 = SPUS OUT0 */
+	au_update_logged("ABOX SBANK_RDMA0", abox, ABOX_SBANK_RDMA0, 0xffffffffu, 0x02000000u); /* 512 bytes at 0 */
+
+	/* RDMA0 as the firmware's setup: volume, buffer, burst 8, format 0x9, bit 5; then enable. */
+	(void)au_read_logged("ABOX RDMA0_CTRL1", abox, RDMA0 + RDMA_CTRL1);
+	(void)au_read_logged("ABOX RDMA0_STATUS", abox, RDMA0 + RDMA_STATUS);
+	au_update_logged("ABOX RDMA0_VOL_FACTOR", abox, RDMA0 + RDMA_VOL_FACTOR, 0xffffffu, 0x800000u);
+	au_update_logged("ABOX RDMA0_VOL_CHANGE", abox, RDMA0 + RDMA_VOL_CHANGE, 0xffffffu, 0);
+	au_update_logged("ABOX RDMA0_CTRL0", abox, RDMA0 + RDMA_CTRL0, 0x70000u, 0);
+	au_update_logged("ABOX RDMA0_BUF_STR", abox, RDMA0 + RDMA_BUF_STR, ~0xfu, pa32);
+	au_update_logged("ABOX RDMA0_BUF_END", abox, RDMA0 + RDMA_BUF_END, ~0xfu, pa32 + TONE_BYTES);
+	au_update_logged("ABOX RDMA0_STR_POINT", abox, RDMA0 + RDMA_STR_POINT, ~0xfu, pa32);
+	au_update_logged("ABOX RDMA0_BUF_OFFSET", abox, RDMA0 + RDMA_BUF_OFFSET, 0xfff0u, TONE_BYTES / 2);
+	au_update_logged("ABOX RDMA0_CTRL0", abox, RDMA0 + RDMA_CTRL0,
+	    (0xfu << 19) | (0x1fu << 8) | (1u << 13) | (1u << 5) | (1u << 4), (8u << 19) | (0x9u << 8) | (1u << 5));
+	au_update_logged("ABOX RDMA0_CTRL0 enable", abox, RDMA0 + RDMA_CTRL0, 1u, 1u);
+	au_tone_poll(abox, 0);
+	au_update_logged("ABOX UAIF2_CTRL0 SPK_ENABLE", abox, ABOX_UAIF2_CTRL0, 1u, 1u);
+	for (unsigned i = 1; i <= 3; i++) {
+		au_sleep_ms(100);
+		au_tone_poll(abox, i);
+	}
+	bool amp = false;
+	if ((au_mask & 64) && au_tfa_ok) {
+		au_tfa_power_up();
+		amp = true;
+	} else if (au_mask & 64) {
+		printf("A50 AUDIO: TFA9872 not set up (step 16), amplifier stays off\n");
+	}
+	for (unsigned i = 4; i <= 13; i++) {
+		au_sleep_ms(300);
+		au_tone_poll(abox, i);
+		if (amp && (i == 5 || i == 9)) {
+			au_tfa_status("playing");
+		}
+	}
+	au_kick(10);
+	if (amp) {
+		au_tfa_power_down();
+	}
+	au_update_logged("ABOX UAIF2_CTRL0 SPK off", abox, ABOX_UAIF2_CTRL0, 1u, 0);
+	au_update_logged("ABOX RDMA0_CTRL0 disable", abox, RDMA0 + RDMA_CTRL0, 1u, 0);
+	au_sleep_ms(50);
+	au_tone_poll(abox, 99);
+	printf("A50 AUDIO: tone done\n");
+}
