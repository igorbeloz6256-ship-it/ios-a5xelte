diff --git a/iokit/bsddev/IOKitBSDInit.cpp b/iokit/bsddev/IOKitBSDInit.cpp
index 47f8964..ea4d164 100644
--- a/iokit/bsddev/IOKitBSDInit.cpp
+++ b/iokit/bsddev/IOKitBSDInit.cpp
@@ -784,9 +784,14 @@ IOFindBSDRoot( char * rootName, unsigned int rootNameSize,
 	 *
 	 * Keys: bsd/dev/a5xelte_keys.c with the A50 table (ALIVE 0x11850000,
 	 * GPA1 pins 7/5/6 = Power/Vol+/Vol-), read only; boot-arg a5keys=0 off.
+	 * Touch: bsd/dev/a50_touch.c, Melfas MSS100 on I2C-4 (a50touch=0 off).
 	 */
 	a5xelte_keys_init();
 	{
+	extern void a50_touch_probe(void);
+	a50_touch_probe();
+	}
+	{
 	uint32_t ufsprobe = 0;
 	PE_parse_boot_argn("ufsprobe", &ufsprobe, sizeof(ufsprobe));
 	if (ufsprobe == 1) {
