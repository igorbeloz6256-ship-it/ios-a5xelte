@@ -95,6 +95,25 @@ au_gated_off(uint32_t gate)
 	return (gate & (1u << 20)) && !(gate & (1u << 21));
 }
 
+/*
+ * xnu20 hung on its first look at the audio blocks: a block whose clock is gated (by the CMU on its own, not only by
+ * hand) does not answer the bus. Before a block is read its clocks are asked for: the CMU gate held on by hand (MANUAL
+ * 20 and CG_VAL 21, as cmucal does for an enabled gate) and the Q-channel's CLOCK_REQ (bit 1) set.
+ */
+static void
+au_clock_on(const char *what, vm_offset_t cmu, uint32_t gate, uint32_t qch)
+{
+	uint32_t g0 = gate ? au_rd(cmu, gate) : 0, q0 = qch ? au_rd(cmu, qch) : 0;
+	if (gate) {
+		au_wr(cmu, gate, g0 | (1u << 20) | (1u << 21));
+	}
+	if (qch) {
+		au_wr(cmu, qch, q0 | (1u << 1));
+	}
+	printf("A50 AUDIO: clock %s on: gate %#x -> %#x, qch %#x -> %#x\n", what, g0, gate ? au_rd(cmu, gate) : 0, q0,
+	    qch ? au_rd(cmu, qch) : 0);
+}
+
 static void
 au_set_field(vm_offset_t base, uint32_t reg, unsigned pin, uint32_t value)
 {
@@ -203,6 +222,12 @@ au_probe_tfa(void)
 	uint32_t ipclk = au_rd(cmgp, 0x2018), pclk = au_rd(cmgp, 0x201c), rst = au_rd(cmgp, 0x2044);
 	printf("A50 AUDIO: CMU_CMGP mux_i2c=%#x div_i2c=%#x gates ipclk=%#x pclk=%#x rstnsync=%#x qch=%#x\n",
 	    au_rd(cmgp, 0x1004), au_rd(cmgp, 0x1804), ipclk, pclk, rst, au_rd(cmgp, 0x3014));
+	/* hsi2c_3's clocks asked for, as ABOX's (see au_clock_on). */
+	au_clock_on("I2C_CMGP00 IPCLK", cmgp, 0x2018, 0x3014);
+	au_clock_on("I2C_CMGP00 PCLK", cmgp, 0x201c, 0);
+	au_clock_on("CMGP_I2C RSTNSYNC", cmgp, 0x2044, 0);
+	ipclk = au_rd(cmgp, 0x2018);
+	pclk = au_rd(cmgp, 0x201c);
 	printf("A50 AUDIO: gpm2 con=%#x dat=%#x pud=%#x gpm3 con=%#x dat=%#x pud=%#x\n", au_rd(pins, GPM2),
