+static bool
+ab_reg(uint8_t chip, uint8_t reg, uint8_t *bytes, unsigned count)
+{
+	lck_mtx_lock(&a50_i2c1_lock);
+	bool ok = ab_reg_locked(chip, reg, bytes, count);
+	lck_mtx_unlock(&a50_i2c1_lock);
+	return ok;
+}
+
+/* SMBus byte write: register address and value in one message, then STOP. */
+static bool
+ab_write_locked(uint8_t chip, uint8_t reg, uint8_t value)
+{
+	const uint8_t bytes[2] = { reg, value };
+	bool ok = false;
+	if (!ab_idle() || !ab_address(chip, false, false)) {
+		goto out;
+	}
+	for (unsigned n = 0; n < 2; n++) {
+		ab_wr(ab_i2c, IICDS, bytes[n]);
+		delay(1);
+		ab_clear_irq();
+		if (!ab_wait_irq()) {
+			ab_fail("write timeout", n);
+			goto out;
+		}
+		if (ab_rd(ab_i2c, IICSTAT) & 1u) {
+			ab_fail("write NACK", n);
+			goto out;
+		}
+	}
+	ok = true;
+out:
+	ab_stop();
+	return ok;
+}
+
+int
+a50_sm5713_read(uint8_t chip, uint8_t reg, uint8_t *value)
+{
+	if (ab_i2c == 0) {
+		return -1;
+	}
+	return ab_reg(chip, reg, value, 1) ? 0 : -1;
+}
+
+/* Read-modify-write of one byte register; *was gets the old value. Nothing is written when the bits already match. */
+int
+a50_sm5713_update(uint8_t chip, uint8_t reg, uint8_t mask, uint8_t value, uint8_t *was)
+{
+	uint8_t old = 0;
+	int ret = -1;
+	if (ab_i2c == 0) {
+		return -1;
+	}
+	lck_mtx_lock(&a50_i2c1_lock);
+	if (ab_reg_locked(chip, reg, &old, 1)) {
+		uint8_t now = (uint8_t)((old & ~mask) | (value & mask));
+		ret = (now == old || ab_write_locked(chip, reg, now)) ? 0 : -1;
+	}
+	lck_mtx_unlock(&a50_i2c1_lock);
+	if (was != NULL) {
+		*was = old;
+	}
+	return ret;
+}
