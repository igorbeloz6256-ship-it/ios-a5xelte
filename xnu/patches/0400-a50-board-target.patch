+#define SWEET_SMP_MAX_CPUS            1     /* boot CPU only until A50 SMP */
+#define A5XELTE_FB_PA                 0xca000000
+#define A5XELTE_FB_WIDTH              1080
+#define A5XELTE_FB_HEIGHT             2340
+#define A5XELTE_FB_STRIDE             4320
+#define A5XELTE_FB_BLOCKS             5     /* 10.1 MB in 2 MiB VA=PA blocks */
+#define A5XELTE_FB_TEXT_SCALE         2
+#define A5XELTE_FB_DOT_PITCH          458   /* iPhone X userland density, as HEROLTE */
+#define A5XELTE_MARKER_PA             0x8ffff100   /* shim/a50 log page + 0x100 */
+#define A5XELTE_BOOT_MPIDR            0x0
+#elif defined(ARM64_BOARD_CONFIG_HEROLTE)
 /* Galaxy S7 SM-G930F: S-Boot leaves DECON_F scanning out this buffer. */
 #define HEROLTE                       1
 /* Logical 0..3: Cortex-A53 "Apollo" MPIDR 0x100..0x103 (boot cluster);
