 /* Firmware scanout buffer and the earliest XNU marker (physical). */
-#if defined(ARM64_BOARD_CONFIG_HEROLTE)
+#if defined(ARM64_BOARD_CONFIG_A50)
+/*
+ * Galaxy A50 SM-A505FN (Exynos 9610). Built as a HEROLTE variant for the
+ * port's generic fixes; the S7 hardware drivers stay off (IOKitBSDInit.cpp,
+ * KernelConfigTables.cpp, bsd_init.c, SweetFramebuffer.cpp). Values from the
+ * stage-0 probe on the phone (A50_PROGRESS.md, 2026-11-13): S-Boot leaves
+ * DECON_F scanning out 0xca000000 (DPU DMA channel 2), 1080x2340 ARGB8888,
+ * and starts XNU's loader on a Cortex-A53 with MPIDR 0x0.
+ */
